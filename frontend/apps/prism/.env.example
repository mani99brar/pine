# Data source: mock | rest | envio | api
#   mock (default): sample data, simulated wallet, demo sign-in. Nothing leaves the browser.
#   api: the Pine backend (packages/api) on this site's origin under /api/v1. Identity is the backend's wallet session
#        (Sign-In with Ethereum) and GitHub is linked through the backend. See the api mode block below.
NEXT_PUBLIC_PINE_DATA_SOURCE=mock
NEXT_PUBLIC_PINE_API_URL=
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
NEXT_PUBLIC_IPFS_GATEWAY=https://cdn.kleros.link
PINE_IPFS_UPLOAD_URL=
PINE_IPFS_UPLOAD_TOKEN=
NEXT_PUBLIC_CHAIN_ID=100
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PINE_DEMO_WALLET=1
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# GitHub OAuth (leave empty to use demo sign-in). Not used in api mode.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- api mode (NEXT_PUBLIC_PINE_DATA_SOURCE=api) ---------------------------------------------------------------------
# NEXT_PUBLIC_* values are compiled into the browser bundle by `next build`: rebuild after changing any of them.
# The browser talks to the backend on its own origin (/api/v1, /api/openapi.json, /.well-known/pine.json): in production
# the edge proxy routes those paths to pine-api, so the app's own /api/* handlers answer 404 and Auth.js stays inert.
# AUTH_SECRET, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, NEXT_PUBLIC_PINE_API_URL, NEXT_PUBLIC_ENVIO_GRAPHQL_URL and
# PINE_IPFS_UPLOAD_* are not used. Leave NEXT_PUBLIC_PINE_DEMO_WALLET unset (api mode never enables the simulated wallet
# unless it is set to 1).
#
# NEXT_PUBLIC_PINE_DATA_SOURCE=api
# The public origin of the site: the same value as PINE_PUBLIC_ORIGIN of the API (the SIWE domain and the CSRF Origin
# check use it). Absolute links in metadata, agent briefs and llms.txt use it too.
# NEXT_PUBLIC_SITE_URL=https://app.pine.example
# Gnosis Chain; the backend only runs on chain 100.
# NEXT_PUBLIC_CHAIN_ID=100
# Pine's deployment, pinned in the bundle: the browser verifies every transaction plan against these, never against what
# the server describes. Same values as PINE_CLAIM_REGISTRY, PINE_EVIDENCE_REGISTRY and PINE_DEPLOYMENT_BLOCK of the API.
# NEXT_PUBLIC_PINE_CLAIM_REGISTRY=0x…
# NEXT_PUBLIC_PINE_EVIDENCE_REGISTRY=0x…
# NEXT_PUBLIC_PINE_DEPLOYMENT_BLOCK=0
# Optional public Gnosis RPC for the wallet's read-only client (balances, ClaimRegistry reads). Visible to every visitor:
# never a URL that carries an API key. Empty uses the wallet library's public default.
# NEXT_PUBLIC_RPC_URL_100=
# Optional WalletConnect Cloud project id (public). Empty lists browser-injected wallets only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server only, never exposed: pine-api on loopback, for public reads during server rendering. With it set, Next.js also
# proxies the backend paths itself (development and e2e without the edge proxy), so the session cookie, the CSRF Origin
# check and the SIWE domain all see one origin.
# PINE_API_INTERNAL_URL=http://127.0.0.1:3000
