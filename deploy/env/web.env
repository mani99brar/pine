# /etc/pine/web.env - configuration of the web app (pine-web.service) AND of its build: NEXT_PUBLIC_* values are compiled
# into the browser bundle by `next build`, so export this file before building (deploy/README.md section 4a) and rebuild
# whenever a NEXT_PUBLIC_* value changes. No secrets: everything here is public or loopback. Install as mode
# 0640 root:pine-web.

# The Pine backend as the data source; identity is the backend's SIWE session.
NEXT_PUBLIC_PINE_DATA_SOURCE=api
# Public origin of the site (absolute links, Open Graph, agent briefs). Same origin as PINE_PUBLIC_ORIGIN of the API.
NEXT_PUBLIC_SITE_URL=https://app.pine.example
NEXT_PUBLIC_CHAIN_ID=100
# Pine's deployment, pinned in the bundle: the browser verifies every transaction plan against these addresses and the
# verified Gnosis constants, never against what the server describes. Same values as PINE_CLAIM_REGISTRY,
# PINE_EVIDENCE_REGISTRY and PINE_DEPLOYMENT_BLOCK of the API (forge deployment record). Replace before building.
NEXT_PUBLIC_PINE_CLAIM_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PINE_EVIDENCE_REGISTRY=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_PINE_DEPLOYMENT_BLOCK=0
# Optional: a public Gnosis RPC for the wallet's read-only client (balances, ClaimRegistry reads). Never a URL with an
# API key: this value is visible to every visitor. Empty uses the wallet library's public default.
NEXT_PUBLIC_RPC_URL_100=
# Optional: WalletConnect Cloud project id (public). Empty lists browser-injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Runtime only: pine-api on loopback, for public reads during server rendering (page metadata). Never exposed.
PINE_API_INTERNAL_URL=http://127.0.0.1:3000
