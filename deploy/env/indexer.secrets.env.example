# /etc/pine/indexer.secrets.env (mode 0640 root:pine-indexer: readable only by pine-indexer-native.service's user). NEVER commit values.
# The indexer runtime role pine_indexer (DML on pine_index only). sslmode=verify-full in production.
DATABASE_URL=
# Two independent https providers (the last two DNS labels of the hosts must differ; pick two different companies).
RPC_PRIMARY_URL=
RPC_SECONDARY_URL=
