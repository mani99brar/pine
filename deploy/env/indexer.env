# /etc/pine/indexer.env - non-secret configuration of the native indexer (pine-indexer-native.service), validated by
# packages/indexer-native/src/config.ts. Install as mode 0640 root:pine-indexer. Secrets live in
# /etc/pine/indexer.secrets.env (mode 0640 root:pine-indexer).

CHAIN_ID=100
PINE_INDEXER_ENV=production
NODE_ENV=production
# Same values as the API's PINE_CLAIM_REGISTRY / PINE_EVIDENCE_REGISTRY / PINE_DEPLOYMENT_BLOCK.
CLAIM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
EVIDENCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
DEPLOYMENT_BLOCK=0
# Reality, ConditionalTokens and the Kleros home proxy default to the verified Gnosis deployment.
QUESTION_TIMEOUT=302400
POLL_INTERVAL_MS=5000
CHUNK_SIZE=500
# Health and metrics (/healthz, /readyz, /metrics): private; port differs from the API's 9464 on the same host.
METRICS_HOST=127.0.0.1
METRICS_PORT=9465
LOG_LEVEL=info
