# /etc/pine/api.secrets.env (mode 0640 root:pine-api: readable only by pine-api.service's user). NEVER commit values.
# Every value is at least 16 characters and is registered with the redactor (never logged or returned).
# Use sslmode=verify-full in every database URL.

# API runtime role (DML only).
PINE_DATABASE_URL=
# Two INDEPENDENT Gnosis RPC providers (different companies); URLs may embed API keys.
PINE_RPC_URL_PRIMARY=
PINE_RPC_URL_SECONDARY=
# GitHub App client secret and the github_app_authorization webhook HMAC secret.
PINE_GITHUB_CLIENT_SECRET=
PINE_GITHUB_WEBHOOK_SECRET=
# GitHub token encryption keys: <id>:<base64 of 32 bytes>. Generate: echo "k$(date +%Y%m):$(openssl rand -base64 32)"
PINE_TOKEN_KEY_CURRENT=
# Retired keys (decrypt only) during a rotation; comma-separated.
PINE_TOKEN_KEYS_PREVIOUS=
# Pine's Kubo RPC API (loopback, see deploy/ipfs) and the Pinning Service API endpoint with a pin-only token.
PINE_KUBO_API_URL=
PINE_PINNING_SERVICE_URL=
PINE_PINNING_SERVICE_TOKEN=
# Read model: the native index through the read-only role pine_readonly (native backend) ...
PINE_READ_MODEL_DATABASE_URL=
# ... or Envio's Hasura GraphQL endpoint with a select-only role (envio backend; no admin secret for the API).
PINE_ENVIO_GRAPHQL_URL=
PINE_ENVIO_ADMIN_SECRET=
