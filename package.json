{
  "name": "pine",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:console": "pnpm --filter @pine/app-console dev",
    "dev:docket": "pnpm --filter @pine/app-docket dev",
    "dev:field": "pnpm --filter @pine/app-field dev",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter './packages/*' test"
  }
}
