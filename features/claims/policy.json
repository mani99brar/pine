{
  "version": "1.2.0",
  "feature": "Claims module",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    { "argv": ["pnpm", "install", "--frozen-lockfile", "--prefer-offline"], "timeout_seconds": 1200 }
  ],
  "workers": [
    {
      "node_id": "claims",
      "role": "backend",
      "required_check_kinds": ["typecheck", "unit"],
      "owned_paths": [
        "packages/api/src/modules/claims",
        "packages/api/migrations/claims"
      ],
      "checks": [
        { "id": "typecheck", "kind": "typecheck", "argv": ["pnpm", "--filter", "@pine/api", "typecheck"], "timeout_seconds": 900, "scenarios": [] },
        { "id": "lint", "kind": "typecheck", "argv": ["pnpm", "exec", "eslint", "packages/api/src"], "timeout_seconds": 900, "scenarios": [] },
        { "id": "forbidden", "kind": "unit", "argv": ["node", "scripts/check-forbidden.mjs"], "timeout_seconds": 120, "scenarios": [] },
        { "id": "unit", "kind": "unit", "argv": ["pnpm", "--filter", "@pine/api", "exec", "vitest", "run", "src/modules/claims"], "timeout_seconds": 1800, "scenarios": [] }
      ]
    }
  ]
}
